# The receptionist's voice server. Separate from call-assistant.service so a
# CRM deploy never has to drop a live call. See README: "Voice server".
#
# Install once, as root:
#   cp /home/deploy/call-assistant/deploy/call-assistant-voice.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now call-assistant-voice
[Unit]
Description=Call assistant voice server (our own receptionist)
After=network.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/call-assistant
Environment=NODE_ENV=production
Environment=VOICE_PORT=4610
ExecStart=/usr/bin/npx tsx src/voice-server/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
