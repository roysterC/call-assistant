# The nightly backup at 3:15am UK time, when no salon is open. Persistent:
# if the box was down at 3:15 it runs on the next boot, since a late backup
# is much better than none.
[Unit]
Description=Call assistant: nightly database backup

[Timer]
OnCalendar=*-*-* 03:15:00 Europe/London
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
