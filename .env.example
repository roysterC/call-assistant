# Database
DATABASE_URL=postgresql://user:password@localhost:5432/doai_calls

# Auth (NextAuth v5 — Credentials provider with JWT sessions)
AUTH_SECRET=                              # openssl rand -base64 32
AUTH_URL=https://call.doaisystems.co.uk
AUTH_TRUST_HOST=true                      # required behind reverse proxy

# Vapi
VAPI_API_KEY=your-vapi-api-key

# Must equal the Secret Key on Vapi's HMAC webhook credential. Configure that
# credential with Vapi's defaults, which is what the verifier expects:
#   Algorithm SHA256 | Signature Header x-signature | Timestamp Header
#   x-timestamp | Payload Format {timestamp}.{body} | Encoding Hex
# Signing the timestamp alongside the body is what makes replay protection
# possible; requests more than 5 minutes old are rejected.
# Legacy schemes (HMAC of the body alone, or the plain secret in
# x-vapi-secret) are still accepted so an older assistant keeps working.
VAPI_WEBHOOK_SECRET=your-webhook-secret

# Google Calendar (salon diary — one calendar per stylist)
#
# A service account, NOT three-legged OAuth: Calendar is a sensitive scope, so
# a consent screen for external users needs Google verification review. Create
# the service account, enable the Calendar API, then share each stylist's
# calendar with the service account address granting "Make changes to events".
#
# The private key keeps its 
 escapes on one line. Surrounding quotes are
# stripped on read, since some hosting dashboards add them silently.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIE...
-----END PRIVATE KEY-----
"

# Dev-only: stylist calendar ids consumed by scripts/seed-salon.ts. Real
# addresses stay out of git, so these live here rather than in the script.
# SHOGO_CAL_JO=
# SHOGO_CAL_SIOBHAN=
# SHOGO_CAL_MARCUS=
# SHOGO_CAL_PRIYA=
# SHOGO_CAL_CHLOE=
# SHOGO_PHONE=+441234567890

# WhatsApp Cloud API (used by webhook verification only)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Meta Graph API — shared by Instagram DMs + Facebook Messenger.
# The webhook at /api/meta/webhook verifies x-hub-signature-256 using
# META_APP_SECRET (HMAC-SHA256 over raw body). Per-org business id +
# access token are configured via the admin UI (/admin/organizations/<id>).
META_VERIFY_TOKEN=pick-any-string-also-set-in-meta-dashboard
META_APP_SECRET=your-meta-app-secret

# SMS (Twilio) — booking confirmations and day-before reminders
#
# Agency-level credentials, following the WhatsApp precedent. The thing that
# genuinely differs per tenant is the sender the customer sees, which comes
# from a PhoneNumber row with channel "sms" (its smsSenderId, or the number
# itself); TWILIO_DEFAULT_SENDER is the fallback.
#
# An alphanumeric sender ID such as SHOGO is cheap and needs no number, but is
# ONE-WAY — customers cannot reply. That is why every message body carries the
# salon's landline, from OrganizationSettings.contactPhone.
#
# Unset means no texts are sent. Bookings still succeed and the agent is told
# not to promise a text it cannot deliver.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_SENDER=

# Shared secret for cron-triggered endpoints (day-before reminders).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Claude AI (shared key for all orgs unless overridden per-org)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Chat model. Optional — defaults to DEFAULT_CHAT_MODEL in src/lib/claude.ts.
# Only claude-haiku-4-5 and claude-sonnet-5 are recognised; each carries its
# own required request params, so don't set an arbitrary model id here.
# Read at runtime, so changing it needs a restart but not a rebuild.
#   claude-haiku-4-5  — cheaper, current default for testing
#   claude-sonnet-5   — use before this faces prospects (Haiku invents stats)
CHAT_MODEL=claude-haiku-4-5

# Our own phone receptionist (src/lib/receptionist). Optional — defaults to
# claude-haiku-4-5, chosen for speed: on a phone line the pause before the
# first word is what the caller notices, and the booking rules are enforced by
# the booking code rather than trusted to the model. Sent no model-specific
# parameters, so claude-sonnet-5 can be tried here as-is; compare with
# `npx tsx scripts/receptionist-calls.ts` before and after.
RECEPTIONIST_MODEL=claude-haiku-4-5

# Its voice server (src/voice-server, run by deploy/call-assistant-voice.service).
# The CRM signs short-lived passes with the secret and the voice server checks
# them, so both processes need the same value: openssl rand -hex 32
# The URL is where browsers reach the voice server: wss://<host>/voice in
# production (proxied to port 4610), ws://localhost:4610/voice locally.
RECEPTIONIST_VOICE_URL=
RECEPTIONIST_VOICE_SECRET=
# Hearing (Deepgram) and speaking (ElevenLabs).
DEEPGRAM_API_KEY=
# Optional: DEEPGRAM_MODEL (nova-3), DEEPGRAM_LANGUAGE (en),
# DEEPGRAM_ENDPOINTING_MS (400 — the pause that ends the caller's turn).
ELEVENLABS_API_KEY=
# Optional: ELEVENLABS_VOICE_ID (a British voice by default), ELEVENLABS_MODEL
# (eleven_flash_v2_5, the low-latency one), ELEVENLABS_SPEED (0.9 by default;
# 1 is the voice's natural pace, 0.7 to 1.2 allowed).
# Local only: VOICE_FAKES=1 runs the voice server with a stand-in model,
# recogniser and voice, for trying the audio path with no provider accounts.

# AI call costs (super-admins see cost and margin; salons see only the charge,
# set per salon as a markup in Admin → Organizations). All optional; defaults:
# USD_TO_GBP=0.78, USAGE_RATE_STT_PER_MIN=0.0077 (Deepgram, $/min),
# USAGE_RATE_TTS_PER_1K_CHARS=0.05 (ElevenLabs, $/1k chars),
# USAGE_RATE_TELEPHONY_PER_MIN=0 (the phone line, $/min).

# Super-admin (for migration script)
SUPER_ADMIN_EMAIL=roy@doaisystems.co.uk
