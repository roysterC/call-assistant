# Database
DATABASE_URL=postgresql://user:password@localhost:5432/doai_calls

# Auth (NextAuth v5 — Credentials provider with JWT sessions)
AUTH_SECRET=                              # openssl rand -base64 32
AUTH_URL=https://call.doaisystems.co.uk
AUTH_TRUST_HOST=true                      # required behind reverse proxy

# Vapi
VAPI_API_KEY=your-vapi-api-key

# Must equal the Secret Key on Vapi's HMAC webhook credential. Configure that
# credential with Vapi's defaults, which is what the verifier expects:
#   Algorithm SHA256 | Signature Header x-signature | Timestamp Header
#   x-timestamp | Payload Format {timestamp}.{body} | Encoding Hex
# Signing the timestamp alongside the body is what makes replay protection
# possible; requests more than 5 minutes old are rejected.
# Legacy schemes (HMAC of the body alone, or the plain secret in
# x-vapi-secret) are still accepted so an older assistant keeps working.
VAPI_WEBHOOK_SECRET=your-webhook-secret

# Google Calendar (salon diary — one calendar per stylist)
#
# A service account, NOT three-legged OAuth: Calendar is a sensitive scope, so
# a consent screen for external users needs Google verification review. Create
# the service account, enable the Calendar API, then share each stylist's
# calendar with the service account address granting "Make changes to events".
#
# The private key keeps its 
 escapes on one line. Surrounding quotes are
# stripped on read, since some hosting dashboards add them silently.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIE...
-----END PRIVATE KEY-----
"

# Dev-only: stylist calendar ids consumed by scripts/seed-salon.ts. Real
# addresses stay out of git, so these live here rather than in the script.
# SHOGO_CAL_JO=
# SHOGO_CAL_SIOBHAN=
# SHOGO_CAL_MARCUS=
# SHOGO_CAL_PRIYA=
# SHOGO_CAL_CHLOE=
# SHOGO_PHONE=+441234567890

# WhatsApp Cloud API (used by webhook verification only)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Meta Graph API — shared by Instagram DMs + Facebook Messenger.
# The webhook at /api/meta/webhook verifies x-hub-signature-256 using
# META_APP_SECRET (HMAC-SHA256 over raw body). Per-org business id +
# access token are configured via the admin UI (/admin/organizations/<id>).
META_VERIFY_TOKEN=pick-any-string-also-set-in-meta-dashboard
META_APP_SECRET=your-meta-app-secret

# Claude AI (shared key for all orgs unless overridden per-org)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Chat model. Optional — defaults to DEFAULT_CHAT_MODEL in src/lib/claude.ts.
# Only claude-haiku-4-5 and claude-sonnet-5 are recognised; each carries its
# own required request params, so don't set an arbitrary model id here.
# Read at runtime, so changing it needs a restart but not a rebuild.
#   claude-haiku-4-5  — cheaper, current default for testing
#   claude-sonnet-5   — use before this faces prospects (Haiku invents stats)
CHAT_MODEL=claude-haiku-4-5

# Super-admin (for migration script)
SUPER_ADMIN_EMAIL=roy@doaisystems.co.uk
