generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Multi-tenancy + Auth
// ─────────────────────────────────────────────────────────────

model Organization {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  planTier                String   @default("starter")
  anthropicApiKeyOverride String?
  // What owners are charged for AI calls, as a percentage on top of what the
  // calls cost us: 100 means they see double our cost. Null hides charges from
  // owners altogether, so a salon is never shown a figure nobody has priced.
  // Only super-admins see the underlying cost.
  usageMarkupPercent      Int?
  enabled                 Boolean  @default(true)
  // The next booking number this salon will hand out. Taken with an atomic
  // increment in the same transaction as the appointment it numbers, so two
  // bookings saved at once (desk and phone) can never share one.
  nextBookingNumber       Int      @default(1001)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                 User[]
  leads                 Lead[]
  calls                 Call[]
  usageRecords          UsageRecord[]
  callbacks             Callback[]
  settings              OrganizationSettings?
  whatsappConversations WhatsAppConversation[]
  websites              WebsiteConfig[]
  websiteConversations  WebsiteConversation[]
  socialConversations   SocialConversation[]
  phoneNumbers          PhoneNumber[]
  appointments          Appointment[]
  timeBlocks            TimeBlock[]

  @@map("ca_organizations")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           String        @default("member") // member, admin, superAdmin, stylist
  organizationId String?
  // Stylist logins only (role "stylist"). A stylist login belongs to one
  // column of the diary — linked by name, as bookings are — and sees what the
  // owner allows. Every other role is unaffected by these.
  stylistName        String?
  /// "own": only their column. "salon": every column, others read-only.
  diaryScope         String  @default("salon")
  /// Their own takings on the sales page. Never anyone else's.
  canSeeTakings      Boolean @default(true)
  /// Set when the owner creates the login or resets its password; the
  /// stylist cannot use anything else until they have chosen their own.
  mustChangePassword Boolean @default(false)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("ca_users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("ca_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ca_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("ca_verification_tokens")
}

model OrganizationSettings {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessName            String
  teamMembers             Json         @default("[]")
  whatsappSystemPrompt    String?
  whatsappEnabled         Boolean      @default(false)
  chatbotEnabled          Boolean      @default(false)
  voiceEnabled            Boolean      @default(false)
  // Cal.com v2 integration (opt-in). When both are set, callbacks created
  // via the Vapi function call will also be booked as Cal.com events.
  calComApiKey            String?
  calComEventTypeId       String?
  // Where the salon's diary lives. "native": our own appointments table is
  // the diary — availability is read from it and a booking is the row itself,
  // so no stylist needs an outside calendar. "google": each stylist's Google
  // Calendar is the diary, as before; kept so a salon that runs its day in
  // Google can stay there, and as the way back if native ever misbehaves.
  diaryProvider           String       @default("native")
  // Salon diary. The booking provider is chosen from what is configured here:
  // Google calendar ids on teamMembers -> google; Cal.com creds -> calcom;
  // otherwise the manual provider, which cannot claim availability at all.
  //
  // businessHours: [{ day: 0-6, closed, open: "HH:MM", close: "HH:MM" }]
  // services:      [{ name, durationMinutes, requiresPatchTest, bufferMinutes }]
  // Both are validated by parseBusinessHours / parseServices on read AND on
  // write, because they drive booking logic and generated prompt text.
  businessHours           Json         @default("[]")
  timezone                String       @default("Europe/London")
  // Printed in outbound texts. The SMS sender is alphanumeric and one-way, so
  // every message has to say where to ring if the time does not suit.
  contactPhone            String?
  services                Json         @default("[]")
  // Voice prompt body, matching the per-channel convention used by
  // whatsappSystemPrompt / instagramSystemPrompt / facebookSystemPrompt. The
  // availability stance and opening hours are generated and prepended at sync
  // time so they cannot drift from what the code enforces.
  voiceSystemPrompt       String?
  vapiAssistantId         String?
  // Instagram Direct Messages (Meta Graph API). When enabled, inbound
  // messages land in /conversations and Claude auto-replies via the
  // per-org instagramSystemPrompt (fallback: generic prompt).
  instagramEnabled        Boolean      @default(false)
  instagramSystemPrompt   String?
  instagramBusinessId     String?
  instagramAccessToken    String?
  // Facebook Messenger (Meta Graph API). Same semantics as Instagram.
  facebookEnabled         Boolean      @default(false)
  facebookSystemPrompt    String?
  facebookPageId          String?
  facebookPageAccessToken String?
  updatedAt               DateTime     @updatedAt

  @@map("ca_organization_settings")
}

model PhoneNumber {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number                String       @unique // E.164 format
  channel               String // "vapi" or "whatsapp"
  vapiPhoneNumberId     String?
  whatsappPhoneNumberId String?
  smsSenderId           String?
  label                 String?
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())

  @@index([organizationId])
  @@index([channel])
  @@index([whatsappPhoneNumberId])
  @@map("ca_phone_numbers")
}

// ─────────────────────────────────────────────────────────────
// Core CRM
// ─────────────────────────────────────────────────────────────

model Call {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vapiCallId     String       @unique
  phoneNumber    String
  status         String       @default("completed") // completed, transferred, voicemail, failed
  duration       Int          @default(0)
  transcript     Json?
  summary        String?
  sentiment      String?
  recordingUrl   String?
  costCents      Int?
  endReason      String?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([phoneNumber])
  @@index([createdAt])
  @@map("ca_calls")
}

model Lead {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String?
  // `name` split for the client list, which sorts and searches on each half.
  // Derived from `name` by the Prisma client whenever a channel writes only
  // the full name (src/lib/prisma.ts), and set directly by the desk's client
  // form, which asks for them separately. `name` stays the display form every
  // other screen and the voice agent read.
  firstName             String?
  lastName              String?
  // Stored lower-cased for the website channel, because it is that channel's
  // identity key and "Sam@x.co.uk" must not become a second lead.
  email                 String?
  // Nullable since website leads are keyed on email and often have no number.
  // It used to be required, so that channel invented one — `website-{session}`
  // — which made a *new* lead every time the same person came back, because
  // the session changed.
  phone                 String?
  company               String?
  issue                 String?
  status                String                 @default("new") // new, callback_booked, contacted, resolved, lost
  source                String                 @default("phone") // phone, manual, whatsapp, website, instagram, facebook
  notes                 String?
  // Reached through another client's number: a child booked on a parent's
  // phone has a record of their own, with their own history, but no number.
  // Their texts go to the contact's number, and a call from that number can
  // manage their bookings. Unset once they have a number of their own, or
  // left in place if the family still wants the parent to hear.
  contactLeadId         String?
  contactLead           Lead?                  @relation("ContactThrough", fields: [contactLeadId], references: [id], onDelete: SetNull)
  dependents            Lead[]                 @relation("ContactThrough")
  calls                 Call[]
  callbacks             Callback[]
  appointments          Appointment[]
  whatsappConversations WhatsAppConversation[]
  websiteConversations  WebsiteConversation[]
  socialConversations   SocialConversation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Two identity keys, one per kind of channel.
  //
  // Phone channels (voice, WhatsApp) know a number and nothing else, so that
  // is what they deduplicate on. The website knows an email and often no
  // number at all, and keying it on phone was wrong in both directions: two
  // people sharing one number — a reception line, a couple — collapsed into a
  // single lead, while one person returning in a new session became several.
  //
  // Postgres permits many NULLs in a unique index, so leads missing either
  // field coexist happily under both constraints.
  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, lastName, firstName])
  @@index([contactLeadId])
  @@index([status])
  @@index([createdAt])
  @@map("ca_leads")
}

model Callback {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id])
  assignedTo      String
  scheduledAt     DateTime
  status          String       @default("pending") // pending | completed | cancelled
  // Outcome captured when operator marks the callback complete.
  // One of: converted | no_answer | not_interested | follow_up | other
  outcome         String?
  completedAt     DateTime?
  notes           String?
  calendarEventId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([scheduledAt])
  @@index([status])
  @@map("ca_callbacks")
}

// ─────────────────────────────────────────────────────────────
// Appointments
//
// Confirmed bookings, not requests. The diary itself lives in the provider
// (Google Calendar, one calendar per stylist); this table is our own record
// so the salon still has one if an event is later edited or deleted, and so
// the dashboard can show what the agent booked overnight without calling
// Google on every page load.
//
// Distinct from Callback on purpose: Callback.scheduledAt/assignedTo describe
// "ring this person back", which is a different thing from "they are booked
// in at two". Calls the agent could NOT book still create a Callback.
// ─────────────────────────────────────────────────────────────

model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  callId         String?

  // The number staff and clients quote ("booking 1043"). Unique per salon,
  // allocated from Organization.nextBookingNumber when the appointment is
  // written. Nullable only for rows written before numbering existed, which
  // scripts/post-deploy.ts numbers after each deploy.
  bookingNumber Int?

  // Verbatim as spoken, then resolved against OrganizationSettings.services.
  // Stored as text rather than a foreign key: the agent hears "a half head of
  // highlights with Jo" down a phone line, and a wrong FK match would book a
  // wrong duration. Staff correct the text; they cannot correct a silent
  // mis-resolution.
  serviceText     String
  durationMinutes Int
  stylistName     String

  startsAt DateTime
  endsAt   DateTime

  // Provider-side identifiers, so an appointment can be cancelled or amended.
  googleEventId    String?
  googleCalendarId String?

  clientType        String  @default("unknown") // new | returning | unknown
  patchTestRequired Boolean @default(false)

  // What was actually taken, in pence. Null until the appointment is marked
  // done — the price list is a guide, and the figure that belongs in a sales
  // report is the one the client paid, not the one the catalogue hoped for.
  amountMinor Int?

  status String  @default("booked") // booked | cancelled | completed | no_show
  source String  @default("voice") // voice | manual
  notes  String?

  // SMS state. Columns rather than a message table: the only question staff
  // ask is "did the text go?", and a delivery-audit story can come later.
  confirmationSentAt DateTime?
  confirmationError  String?
  // Set the moment a reminder is attempted, not when it succeeds, so a cron
  // run that overlaps itself cannot text the same client twice.
  reminderSentAt     DateTime?
  reminderError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, bookingNumber])
  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([leadId])
  @@map("ca_appointments")
}

// ─────────────────────────────────────────────────────────────
// WhatsApp
// ─────────────────────────────────────────────────────────────

model WhatsAppConversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waId           String
  phoneNumber    String
  contactName    String?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  status         String       @default("active")
  isRead         Boolean      @default(false)
  starred        Boolean      @default(false)
  lastMessageAt  DateTime     @default(now())

  messages  WhatsAppMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // When the org's system prompt changes, the admin can flip this to
  // NOW() so the AI ignores conversation history older than the reset
  // when generating its next reply. Customer-facing inbox UI still
  // shows the full history — only the prompt-construction path filters.
  // NULL = no reset, feed all history (default behaviour).
  personaResetAt DateTime?

  @@unique([organizationId, waId])
  @@index([organizationId])
  @@index([waId])
  @@index([phoneNumber])
  @@index([status])
  @@index([lastMessageAt])
  // Compound indexes covering the conversations-page query patterns:
  //   - default sort (orgId + lastMessageAt DESC)
  //   - unread filter (orgId + isRead, then range over lastMessageAt)
  //   - starred filter (orgId + starred + lastMessageAt DESC)
  // Without these, the unread/starred filters on a tenant with 10k+
  // conversations table-scan after picking the orgId index.
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, isRead, lastMessageAt(sort: Desc)])
  @@index([organizationId, starred, lastMessageAt(sort: Desc)])
  @@map("ca_whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  waMessageId    String?              @unique
  status         String               @default("sent")
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("ca_whatsapp_messages")
}

// ─────────────────────────────────────────────────────────────
// Website chatbot
// ─────────────────────────────────────────────────────────────

model WebsiteConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  name           String
  botName        String       @default("Assistant")
  systemPrompt   String
  greeting       String?
  quickReplies   Json         @default("[]")
  brandColor     String       @default("#2563eb")
  allowedOrigins Json         @default("[]")
  enabled        Boolean      @default(true)

  // Launcher presentation. Position and offset exist mainly to get out of the
  // way of whatever else already lives in a client's bottom-right corner —
  // cookie banners, back-to-top buttons, other vendors' widgets.
  launcherPosition String  @default("right") // "right" | "left"
  launcherOffset   Int     @default(20) // px from the bottom and side
  launcherLabel    String? // e.g. "Chat with us" — pill instead of a circle
  launcherIcon     String? // single emoji; null uses the default chat glyph

  // Panel theme. "auto" follows the visitor's OS setting.
  theme      String @default("light") // "light" | "dark" | "auto"
  fontFamily String @default("system") // see FONT_STACKS in the embed page

  // Which Claude model answers for this site. null means "best the plan
  // allows". Always re-clamped against the org's planTier at request time, so
  // a stored choice cannot outlive a downgrade.
  chatModel String?

  // White-label. Only honoured on plans permitted to remove attribution —
  // re-checked server-side per request, so a downgrade restores it without
  // anyone rewriting stored rows.
  hideBranding Boolean @default(false)

  // Proactive teaser: a small prompt that appears beside the collapsed
  // launcher after a delay, to open a conversation rather than waiting to be
  // found. Off by default — an unsolicited popup on a client's site is their
  // decision to make, not a default we impose.
  proactiveEnabled       Boolean @default(false)
  proactiveMessage       String?
  proactiveDelaySeconds  Int     @default(15)
  // Hours before the same visitor may be shown it again. 0 means once only.
  proactiveCooldownHours Int     @default(24)

  // Where the widget sends someone who wants a person.
  //
  // This replaced a "Talk to a person" button. That button promised a human on
  // a product whose whole premise is that nobody is watching the chats — a
  // visitor asking for someone got silence. Pointing them at the booking or
  // contact form the client already has is a promise the site can actually
  // keep.
  //
  // ctaSelector is a CSS selector on the *host* page (e.g. "#book-a-demo"):
  // widget.js scrolls to it and focuses the first field. ctaUrl is the
  // fallback for pages where that element doesn't exist. Both null means no
  // button — better to offer nothing than a control that goes nowhere.
  ctaLabel    String?
  ctaSelector String?
  ctaUrl      String?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  conversations WebsiteConversation[]

  @@unique([siteId])
  @@index([organizationId])
  @@map("ca_website_configs")
}

model WebsiteConversation {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId             String
  site               WebsiteConfig    @relation(fields: [siteId], references: [siteId])
  sessionId          String           @unique
  leadId             String?
  lead               Lead?            @relation(fields: [leadId], references: [id])
  visitorName        String?
  visitorEmail       String?
  visitorPhone       String?
  status             String           @default("active")
  isRead             Boolean          @default(false)
  starred            Boolean          @default(false)
  lastMessageAt      DateTime         @default(now())
  // Human handoff. "bot" is the normal state; "requested" means the visitor
  // asked for a person and the bot has stopped answering; "human" means an
  // operator has actually replied. The bot stays silent in both non-bot
  // states — answering over a waiting human is worse than a slow reply.
  handoffState       String           @default("bot")
  handoffRequestedAt DateTime?
  userAgent          String?
  referrer           String?
  messages           WebsiteMessage[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // See WhatsAppConversation for personaResetAt rationale.
  personaResetAt DateTime?

  @@index([organizationId])
  @@index([siteId])
  @@index([sessionId])
  @@index([lastMessageAt])
  // See WhatsAppConversation for index rationale.
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, isRead, lastMessageAt(sort: Desc)])
  @@index([organizationId, starred, lastMessageAt(sort: Desc)])
  @@map("ca_website_conversations")
}

model WebsiteMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   WebsiteConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@map("ca_website_messages")
}

// ─────────────────────────────────────────────────────────────
// Social messaging (Instagram DMs + Facebook Messenger)
//
// Unified pair for channels that ride Meta's Graph API but aren't
// WhatsApp. `channel` column distinguishes them ("instagram" | "facebook")
// and the table shape is extensible to future social channels (Twitter
// DMs, etc.) without further schema changes. WhatsApp keeps its own
// tables — those already work and migrating them is out of scope.
// ─────────────────────────────────────────────────────────────

model SocialConversation {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        String // "instagram" | "facebook"
  externalUserId String // IG scoped user id OR Messenger PSID
  contactName    String?
  // Cached profile data fetched from Graph API on first contact, used for
  // displaying the lead with a real handle and avatar instead of the
  // opaque externalUserId. `contactHandle` is IG @username; FB has no
  // native handle equivalent so it stays null for facebook conversations.
  contactHandle  String?
  profilePicUrl  String?
  leadId         String?
  lead           Lead?           @relation(fields: [leadId], references: [id])
  status         String          @default("active")
  isRead         Boolean         @default(false)
  starred        Boolean         @default(false)
  lastMessageAt  DateTime        @default(now())
  messages       SocialMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // See WhatsAppConversation for personaResetAt rationale.
  personaResetAt DateTime?

  @@unique([organizationId, channel, externalUserId])
  @@index([organizationId])
  @@index([channel])
  @@index([lastMessageAt])
  // See WhatsAppConversation for index rationale.
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, isRead, lastMessageAt(sort: Desc)])
  @@index([organizationId, starred, lastMessageAt(sort: Desc)])
  @@map("ca_social_conversations")
}

model SocialMessage {
  id                String             @id @default(cuid())
  conversationId    String
  conversation      SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String // "user" | "assistant"
  content           String
  externalMessageId String?            @unique
  status            String             @default("sent")
  createdAt         DateTime           @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("ca_social_messages")
}

/// Time a stylist (or the whole salon) cannot be booked: lunch, a holiday,
/// training, a bank holiday closure.
///
/// Two shapes. A one-off block is a pair of instants, which covers an hour, a
/// day or a fortnight's holiday alike. A weekly block is a rule — these
/// weekdays, this wall-clock window, between these dates — expanded per day in
/// the salon's timezone when read (src/lib/time-blocks.ts), so "1pm to 2pm"
/// stays 1pm to 2pm across the clock change. Storing each week as its own row
/// would drift at the change and need topping up forever.
model TimeBlock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null blocks everyone: the salon is shut.
  stylistName String?
  label       String
  allDay      Boolean @default(false)

  /// "none" | "weekly"
  repeat String @default("none")

  // One-off: the instants it runs between.
  startsAt DateTime?
  endsAt   DateTime?

  // Weekly: 0 = Sunday ... 6 = Saturday, "HH:MM" wall-clock times ("24:00"
  // for end of day), and the YYYY-MM-DD dates it runs from and until
  // (inclusive, until optional). skipDates are single weeks taken out.
  weekdays  Int[]    @default([])
  startTime String?
  endTime   String?
  fromDate  String?
  untilDate String?
  skipDates String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("ca_time_blocks")
}

// What our own receptionist cost to run, one row per call (or per typed lab
// turn). Vapi calls are not here: Vapi reports its own cost, kept on Call.
//
// The cost is worked out from the usage when the row is written and stored in
// US dollars (the currency the providers bill in), in millionths, so a later
// price change never rewrites what an old call cost.
model UsageRecord {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // "lab_voice" and "lab_chat" today; "phone" once our receptionist answers
  // real calls. Lab usage is ours, not the salon's, and is never charged.
  source           String
  // Groups the turns of one typed lab conversation into one "call".
  sessionKey       String?
  startedAt        DateTime
  durationSeconds  Int          @default(0)
  model            String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  sttSeconds       Float        @default(0)
  ttsCharacters    Int          @default(0)
  telephonySeconds Int          @default(0)
  costMicros       Int
  createdAt        DateTime     @default(now())

  @@index([organizationId, startedAt])
  @@map("ca_usage_records")
}
