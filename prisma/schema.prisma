generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Multi-tenancy + Auth
// ─────────────────────────────────────────────────────────────

model Organization {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  planTier                String   @default("starter")
  // What kind of business it is (src/lib/business-types.ts): "hair",
  // "nails", "beauty" or "barber". Set by Kikai, not the salon. Changes what
  // the receptionist and chat bots know about the trade, never the diary.
  businessType            String   @default("hair")
  // Other types it also offers, e.g. ["beauty"] for a hair and beauty salon.
  alsoOffers              String[] @default([])
  anthropicApiKeyOverride String?
  // What owners are charged for AI calls, as a percentage on top of what the
  // calls cost us: 100 means they see double our cost. Null hides charges from
  // owners altogether, so a salon is never shown a figure nobody has priced.
  // Only super-admins see the underlying cost.
  usageMarkupPercent      Int?
  enabled                 Boolean  @default(true)
  // The next booking number this salon will hand out. Taken with an atomic
  // increment in the same transaction as the appointment it numbers, so two
  // bookings saved at once (desk and phone) can never share one.
  nextBookingNumber       Int      @default(1001)
  // On for a salon made with an owner invite (src/lib/invitations.ts):
  // its owner is taken through /onboarding (name, type, hours, services,
  // team) before anything else, and finishing turns it off. Off by default,
  // so salons set up by hand never see onboarding.
  needsOnboarding         Boolean  @default(false)
  // The onboarding step the owner has reached (src/lib/onboarding.ts), for
  // Kikai to see where they are. Null before they start.
  onboardingStep          String?
  // ── Billing (src/lib/plan.ts) ──
  // Every salon has the base plan: diary, clients, booking, sales and its
  // website. "free": not billed (salons from before billing, Kikai's own),
  // with everything it has switched on. "trialing": the 14-day free trial,
  // then Stripe's own state ("active", "past_due"), and "restricted" when the
  // trial ended without a card or Stripe gave up on a payment: bookings stay,
  // making new ones stops (src/lib/plan-access.ts).
  billingStatus           String   @default("free")
  // When the free trial ends. Set when the owner first signs in (or when a
  // salon is made without an owner invite), so an invite left unread for a
  // week does not eat the trial.
  trialEndsAt             DateTime?
  stripeCustomerId        String?  @unique
  stripeSubscriptionId    String?  @unique
  // The paid add-ons on the salon's plan (ADDONS in src/lib/plan.ts). What
  // is switched on is still the settings' own switches; an add-on missing
  // here keeps its switch from working on a billed salon.
  addons                  String[] @default([])
  // Add-ons the owner asked for that Kikai sets up first (the receptionist
  // needs a phone number): shown to Kikai in Admin.
  addonRequests           String[] @default([])
  // The extra team members last sent to Stripe, so a change is sent once.
  billedSeats             Int?
  // The first failed payment of the current run of failures; null once paid.
  paymentFailedAt         DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                 User[]
  leads                 Lead[]
  calls                 Call[]
  assistantSessions     AssistantSession[]
  chatSessions          ChatSession[]
  chatPhotos            ChatPhoto[]
  quotes                Quote[]
  rebookTexts           RebookText[]
  technicians           Technician[]
  usageRecords          UsageRecord[]
  callbacks             Callback[]
  settings              OrganizationSettings?
  whatsappConversations WhatsAppConversation[]
  websites              WebsiteConfig[]
  websiteConversations  WebsiteConversation[]
  socialConversations   SocialConversation[]
  phoneNumbers          PhoneNumber[]
  appointments          Appointment[]
  timeBlocks            TimeBlock[]
  invitations           Invitation[]
  billingInvoices       BillingInvoice[]

  @@map("ca_organizations")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String?
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               String             @default("member") // member, admin, superAdmin
  organizationId     String?
  // Withdrawn: stylist logins (role "stylist") were removed. @ignore keeps
  // these out of the Prisma client, so nothing loads them, while the columns
  // stay until they are dropped by hand on the box; the deploy refuses to
  // drop columns itself (see README, schema-change policy). Delete these
  // lines once the columns are gone.
  stylistName        String?            @ignore
  diaryScope         String             @default("salon") @ignore
  canSeeTakings      Boolean            @default(true) @ignore
  mustChangePassword Boolean            @default(false)
  /// The language this person reads the CRM in ("en", "vi"), chosen in
  /// Account or on the login page. Null until they choose: the device's
  /// choice (the kikai-lang cookie) stands until then.
  language           String?
  /// The clock this person reads times on ("12h", "24h"), chosen in Account.
  /// Null until they choose: it follows their language until then.
  clock              String?
  /// Copied into the login cookie at sign-in. Raising it (a password changed
  /// or reset) ends every session signed in before, on their next request.
  sessionVersion     Int                @default(0)
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  accounts           Account[]
  sessions           Session[]
  bookingNotices     BookingNotice[]
  pushSubscriptions  PushSubscription[]
  /// The nail technician this login is, if any (Technician.userId).
  technician         Technician?
  authTokens         AuthToken[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("ca_users")
}

/// A link that lets someone make their own login for a salon: Kikai creates
/// the salon, invites its owner, and sends them the link. Only a SHA-256 of
/// the link's token is kept, so a copy of the database cannot be used to sign
/// up. Works once, until `expiresAt`. See src/lib/invitations.ts.
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  /// The role the new login gets: "admin" (owner) or "member" (staff).
  role           String       @default("admin")
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  /// "email": sent to the address by the app, and the link never shown to
  /// anyone else, so accepting it proves the address. "link": shown to
  /// Kikai to pass on, so it proves nothing about the address.
  delivery       String       @default("link")
  /// The language the email is written in and the invite page opens in
  /// ("en", "vi"); the new login starts in whichever they end up choosing.
  language       String       @default("en")
  /// Kikai's own words to them, after the call: shown at the top of the email.
  note           String?
  /// When the "your login is waiting" reminder went, so it goes once.
  remindedAt     DateTime?
  /// The super-admin who sent it.
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("ca_invitations")
}

/// A one-time link emailed to a login's own address: to set a new password
/// ("reset") or to confirm the address is theirs ("verify"). Only a SHA-256
/// of the token is kept. See src/lib/auth-tokens.ts.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@map("ca_auth_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("ca_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ca_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("ca_verification_tokens")
}

model OrganizationSettings {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessName            String
  teamMembers             Json         @default("[]")
  whatsappSystemPrompt    String?
  whatsappEnabled         Boolean      @default(false)
  // The salon's diary, clients, sales and callbacks, on their own: a salon
  // can run its book on Kikai with no receptionist at all. On whenever the
  // phone receptionist or booking by message is, which need it (hasDiary in
  // src/lib/navigation.ts).
  diaryEnabled            Boolean      @default(false)
  // Clients due back for a service (its rebookWeeks) get a text with a link
  // into the salon's WhatsApp or Instagram chat to book (src/lib/rebook.ts).
  // The salon's own choice, in Settings; off until switched on.
  rebookTextsEnabled      Boolean      @default(false)
  // Who the salon's texts come from: a name of up to 11 characters ("HOANG
  // NAILS") or a number, set by Kikai in Admin (src/lib/sms-sender.ts). Null:
  // a texting number of its own, else the server's TWILIO_DEFAULT_SENDER.
  smsSender               String?
  // The salon's Instagram @username, for the link in a rebooking text when it
  // has no WhatsApp: ig.me/m/<username>. Without the @.
  instagramUsername       String?
  // WhatsApp, Instagram and Messenger may book into the diary, with the same
  // checks and read-back as the phone (src/lib/chat-booking.ts). Off until
  // Kikai switches it on; the salon's own diary must be set up as well.
  chatBookingEnabled      Boolean      @default(false)
  chatbotEnabled          Boolean      @default(false)
  voiceEnabled            Boolean      @default(false)
  // Cal.com v2 integration (opt-in). When both are set, callbacks created
  // via the Vapi function call will also be booked as Cal.com events.
  calComApiKey            String?
  calComEventTypeId       String?
  // Where the salon's diary lives. "native": our own appointments table is
  // the diary — availability is read from it and a booking is the row itself,
  // so no stylist needs an outside calendar. "google": each stylist's Google
  // Calendar is the diary, as before; kept so a salon that runs its day in
  // Google can stay there, and as the way back if native ever misbehaves.
  diaryProvider           String       @default("native")
  // No longer used: it was a chosen start page (Settings → Start page), and
  // the diary is now everyone's start page (resolveStartPage in
  // src/lib/navigation.ts). Left in place because schema changes here only
  // ever add; drop it in a deliberate migration.
  startPage               String?
  // Salon diary. The booking provider is chosen from what is configured here:
  // Google calendar ids on teamMembers -> google; Cal.com creds -> calcom;
  // otherwise the manual provider, which cannot claim availability at all.
  //
  // businessHours: [{ day: 0-6, closed, open: "HH:MM", close: "HH:MM" }]
  // services:      [{ name, durationMinutes, requiresPatchTest, bufferMinutes }]
  // Both are validated by parseBusinessHours / parseServices on read AND on
  // write, because they drive booking logic and generated prompt text.
  businessHours           Json         @default("[]")
  timezone                String       @default("Europe/London")
  // Printed in outbound texts. The SMS sender is alphanumeric and one-way, so
  // every message has to say where to ring if the time does not suit.
  contactPhone            String?
  services                Json         @default("[]")
  // The price list as treatments, finishes and extras (src/lib/nail-menu.ts).
  // When set, `services` is made from it on every save; null when the list
  // was last written flat, and a menu is then made from `services` to show.
  menu                    Json?
  // Voice prompt body, matching the per-channel convention used by
  // whatsappSystemPrompt / instagramSystemPrompt / facebookSystemPrompt. The
  // availability stance and opening hours are generated and prepended at sync
  // time so they cannot drift from what the code enforces.
  voiceSystemPrompt       String?
  // The salon's own answers to common questions (address, parking, policies,
  // vouchers), written by the owner in Settings. Given to the phone
  // receptionist and the chat bots, which answer questions about the salon
  // only from this and the settings above. See src/lib/salon-knowledge.ts.
  salonFaq                String?
  vapiAssistantId         String?
  // Instagram Direct Messages (Meta Graph API). When enabled, inbound
  // messages land in /conversations and Claude auto-replies via the
  // per-org instagramSystemPrompt (fallback: generic prompt).
  instagramEnabled        Boolean      @default(false)
  instagramSystemPrompt   String?
  instagramBusinessId     String?
  instagramAccessToken    String?
  // Facebook Messenger (Meta Graph API). Same semantics as Instagram.
  facebookEnabled         Boolean      @default(false)
  facebookSystemPrompt    String?
  facebookPageId          String?
  facebookPageAccessToken String?
  // The salon's own Meta app, which carries its WhatsApp, Instagram and
  // Messenger. Meta signs every webhook with the app's secret, and the
  // subscribe handshake echoes the verify token typed into the app's webhook
  // settings. Per salon, so no salon's messages can be forged with another's
  // keys (src/lib/meta-credentials.ts).
  metaAppSecret           String?
  // Instagram's own app secret (Instagram → API setup with Instagram login),
  // which Meta signs Instagram webhooks with instead of the app secret above.
  // Either one vouches for an Instagram or Messenger delivery.
  instagramAppSecret      String?
  metaVerifyToken         String?
  // WhatsApp Cloud API token for sending; the number it sends from is the
  // PhoneNumber row the customer wrote to.
  whatsappAccessToken     String?
  // Online booking (src/lib/online-booking): the salon's own website at
  // /s/<slug>, and the same booking flow as a link or embed on a site the
  // salon already has. The salon's own choice, in Settings; off until then.
  // Services, team, hours and prices come from the fields above, so the site
  // can never disagree with the diary; these are only what the site adds.
  onlineBookingEnabled    Boolean      @default(false)
  siteHeadline            String?
  siteAbout               String?
  siteAddress             String?
  // "#RRGGBB", checked on the way in. Null: the default.
  siteBrandColor          String?
  // How far ahead clients may book online, in days.
  onlineMaxDaysAhead      Int          @default(56)
  // Whether clients may pick who they see, or are only offered "anyone".
  onlineStylistChoice     Boolean      @default(true)
  // Services clients cannot book online (a consultation, colour correction),
  // by name. Hidden rather than listed-as-bookable, so a new service is
  // bookable online by default, the way it is by phone.
  onlineHiddenServices    String[]     @default([])
  // A chat from Websites (WebsiteConfig.siteId) shown on the salon's own
  // page and booking page, with its button opening online booking. Only
  // while website chat is on for the salon (chatbotEnabled); null for none.
  siteChatSiteId          String?
  updatedAt               DateTime     @updatedAt

  @@map("ca_organization_settings")
}

model PhoneNumber {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number                String       @unique // E.164 format
  channel               String // "vapi" or "whatsapp"
  vapiPhoneNumberId     String?
  whatsappPhoneNumberId String?
  smsSenderId           String?
  label                 String?
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())

  @@index([organizationId])
  @@index([channel])
  @@index([whatsappPhoneNumberId])
  @@map("ca_phone_numbers")
}

// ─────────────────────────────────────────────────────────────
// Core CRM
// ─────────────────────────────────────────────────────────────

model Call {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Set for calls Vapi answered; null for our own receptionist's calls.
  vapiCallId     String?      @unique
  phoneNumber    String
  // What the call came to, for our own receptionist: any of booked,
  // rescheduled, cancelled, message, enquiry, hung_up. No transcript or
  // summary is kept for these calls; this is the whole record.
  outcomes       String[]     @default([])
  status         String       @default("completed") // completed, transferred, voicemail, failed
  duration       Int          @default(0)
  transcript     Json?
  summary        String?
  sentiment      String?
  recordingUrl   String?
  costCents      Int?
  endReason      String?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([phoneNumber])
  @@index([createdAt])
  @@map("ca_calls")
}

// A photo a client sent on WhatsApp, Instagram or Messenger, usually of the
// nails they want (src/lib/chat-photos.ts). Kept for the salon, and linked
// to the booking made in that conversation so the technician sees it with
// the appointment. The bytes are kept here: a few hundred kilobytes each.
model ChatPhoto {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        String
  conversationId String
  mediaType      String
  data           Bytes
  caption        String?
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([channel, conversationId])
  @@index([appointmentId])
  @@map("ca_chat_photos")
}

// A client's request for a price on designs they sent in a chat (photos),
// and the salon's answer (src/lib/quotes.ts). The receptionist files it
// instead of a call back; whoever answers enters a price, and optionally a
// time, for each design, and the reply goes back in the same chat.
model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The chat it came from: whatsapp, instagram or facebook, and its conversation.
  channel        String
  conversationId String
  clientName     String?
  // E.164, when they gave one: the reply goes by text once the chat's
  // 24-hour window has closed.
  clientPhone    String?
  // What they asked for, in the receptionist's words: service, length,
  // shape, when they would like it.
  request        String
  // One per design, in the order sent: { photoId, priceMinor, minutes, declined }.
  items          Json
  // requested, then sent.
  status         String       @default("requested")
  sentAt         DateTime?
  sentBy         String?
  // How the reply went: "chat", or "sms" after the chat's window closed.
  sentVia        String?
  // When the client booked a design from it in the chat: a quote is used
  // for one booking, so a later one in the same chat is at the price list.
  bookedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([channel, conversationId])
  @@map("ca_quotes")
}

// A rebooking text: "your infill is due, Thursday 3pm is free", with a short
// link (/r/<id>) into the salon's WhatsApp or Instagram chat to book it
// (src/lib/rebook.ts). Kept so a client is not texted twice for one visit,
// and so the salon can see how many were opened and led to a booking.
model RebookText {
  // Short and unguessable: it is the link in the text.
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  // The visit it follows on from; one text per visit.
  appointmentId  String       @unique
  service        String
  stylist        String?
  /// The technician offered, by id.
  technicianId   String?
  technician     Technician?  @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  // The free time it offered, if one was found.
  slotStartsAt   DateTime?
  sentAt         DateTime     @default(now())
  sendError      String?
  openedAt       DateTime?
  stoppedAt      DateTime?

  @@index([organizationId, sentAt])
  @@index([leadId])
  @@map("ca_rebook_texts")
}

// Where a booking conversation on WhatsApp, Instagram or Messenger stands
// between messages (src/lib/chat-booking.ts): the model's history with its
// diary checks, and what was last read back, so a "yes" in the next message
// books what was read back. The messages themselves stay in the channel's
// own tables. Started afresh after a quiet spell.
model ChatSession {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        String
  conversationId String
  messages       Json
  state          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([channel, conversationId])
  @@index([organizationId])
  @@map("ca_chat_sessions")
}

// A conversation with the personal assistant (src/lib/voice-booking), kept
// for review while it is in testing, as the receptionist's calls are on Call.
// Written after every turn, so a session the server forgets is still kept.
// Text only: what was said or typed, the replies, and each tool with its
// answer. Kept indefinitely for now, like call transcripts.
model AssistantSession {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  speaker        String?
  transcript     Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([createdAt])
  @@map("ca_assistant_sessions")
}

model Lead {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String?
  // `name` split for the client list, which sorts and searches on each half.
  // Derived from `name` by the Prisma client whenever a channel writes only
  // the full name (src/lib/prisma.ts), and set directly by the desk's client
  // form, which asks for them separately. `name` stays the display form every
  // other screen and the voice agent read.
  firstName             String?
  lastName              String?
  // Stored lower-cased for the website channel, because it is that channel's
  // identity key and "Sam@x.co.uk" must not become a second lead.
  email                 String?
  // Nullable since website leads are keyed on email and often have no number.
  // It used to be required, so that channel invented one — `website-{session}`
  // — which made a *new* lead every time the same person came back, because
  // the session changed.
  phone                 String?
  company               String?
  issue                 String?
  status                String                 @default("new") // new, callback_booked, contacted, resolved, lost
  source                String                 @default("phone") // phone, manual, whatsapp, website, instagram, facebook
  notes                 String?
  // The day of the client's most recent skin (patch) test, recorded at the
  // desk on the client's page. Stored at noon UTC so the date reads the same
  // in any timezone. Null when none is on record.
  patchTestAt           DateTime?
  // Set when the salon deleted this client. Their name, number, email and
  // notes are wiped, but the row stays so their past bookings, and the
  // takings on them, still have a client to belong to; screens show them as
  // "Deleted client" and leave them out of every list (lib/client-delete).
  anonymisedAt          DateTime?
  // Asked to stop rebooking texts (the stop link in each one, src/lib/rebook.ts).
  rebookTextsOff        Boolean                @default(false)
  // Reached through another client's number: a child booked on a parent's
  // phone has a record of their own, with their own history, but no number.
  // Their texts go to the contact's number, and a call from that number can
  // manage their bookings. Unset once they have a number of their own, or
  // left in place if the family still wants the parent to hear.
  contactLeadId         String?
  contactLead           Lead?                  @relation("ContactThrough", fields: [contactLeadId], references: [id], onDelete: SetNull)
  dependents            Lead[]                 @relation("ContactThrough")
  // Made from details nobody proved (typed on the website, or in an Instagram
  // or Messenger chat) that another client already has: anyone can type a
  // client's number or email, so they never open her card. This is the card
  // they matched, for the salon to merge the two or clear the flag
  // (src/lib/client-identity.ts).
  possibleDuplicateOfId String?
  possibleDuplicateOf   Lead?                  @relation("PossibleDuplicate", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull)
  possibleDuplicates    Lead[]                 @relation("PossibleDuplicate")
  calls                 Call[]
  callbacks             Callback[]
  appointments          Appointment[]
  whatsappConversations WhatsAppConversation[]
  websiteConversations  WebsiteConversation[]
  socialConversations   SocialConversation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // One card per person, and a number or email is not a person: a family
  // shares a phone, a couple an email. So neither is unique. Who a number
  // reaches is decided in one place, src/lib/client-identity.ts: its first
  // card, with the rest told apart by name, and only for a number the channel
  // proved (caller ID, WhatsApp) or the salon's staff typed.
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([possibleDuplicateOfId])
  @@index([organizationId])
  @@index([organizationId, lastName, firstName])
  @@index([contactLeadId])
  @@index([status])
  @@index([createdAt])
  @@map("ca_leads")
}

model Callback {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id])
  assignedTo      String
  /// The technician it is for, by id; null for "Team" (anyone).
  technicianId    String?
  technician      Technician?  @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  scheduledAt     DateTime
  status          String       @default("pending") // pending | completed | missed
  // Outcome captured when the salon marks the callback done.
  // Now one of: booked | sorted | not_needed. Older rows may hold
  // converted | no_answer | not_interested | follow_up | other.
  outcome         String?
  completedAt     DateTime?
  notes           String?
  calendarEventId String?
  // Where the message was left: "call", or the chat it came from
  // (whatsapp, instagram, facebook, website), with that chat's id so the
  // Callbacks page can open it. Null on messages from before this was kept.
  channel         String?
  conversationId  String?
  // Rung with no answer: how many times, and the last, so the list says
  // "Tried 2× · no answer" and the callback stays on it.
  attempts        Int          @default(0)
  lastAttemptAt   DateTime?
  // Who marked it done (a name, as the screens show it), and what they
  // noted about it ("booked Thu 3:30 with Lan").
  handledBy       String?
  resultNote      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([scheduledAt])
  @@index([status])
  @@index([organizationId, technicianId])
  @@map("ca_callbacks")
}

// ─────────────────────────────────────────────────────────────
// Appointments
//
// Confirmed bookings, not requests. The diary itself lives in the provider
// (Google Calendar, one calendar per stylist); this table is our own record
// so the salon still has one if an event is later edited or deleted, and so
// the dashboard can show what the agent booked overnight without calling
// Google on every page load.
//
// Distinct from Callback on purpose: Callback.scheduledAt/assignedTo describe
// "ring this person back", which is a different thing from "they are booked
// in at two". Calls the agent could NOT book still create a Callback.
// ─────────────────────────────────────────────────────────────

model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  callId         String?

  // The number staff and clients quote ("booking 1043"). Unique per salon,
  // allocated from Organization.nextBookingNumber when the appointment is
  // written. Nullable only for rows written before numbering existed, which
  // scripts/post-deploy.ts numbers after each deploy.
  bookingNumber Int?

  // Verbatim as spoken, then resolved against OrganizationSettings.services.
  // Stored as text rather than a foreign key: the agent hears "a half head of
  // highlights with Jo" down a phone line, and a wrong FK match would book a
  // wrong duration. Staff correct the text; they cannot correct a silent
  // mis-resolution.
  serviceText     String
  durationMinutes Int
  stylistName     String
  /// The technician, by id: what clashes, busy times and takings match on, so
  /// renaming her changes nothing that books. stylistName is her name, kept in
  /// step on a rename (src/lib/technicians.ts). Null only on rows the
  /// post-deploy backfill has not reached yet.
  technicianId    String?
  technician      Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  startsAt DateTime
  endsAt   DateTime

  // Provider-side identifiers, so an appointment can be cancelled or amended.
  googleEventId    String?
  googleCalendarId String?

  clientType        String  @default("unknown") // new | returning | unknown
  patchTestRequired Boolean @default(false)

  // What was actually taken, in pence. Null until the appointment is marked
  // done — the price list is a guide, and the figure that belongs in a sales
  // report is the one the client paid, not the one the catalogue hoped for.
  amountMinor      Int?
  // The price the salon quoted for this design in the chat, in pence:
  // what the diary shows instead of the price list's, which is for the
  // plain service ("Acrylic infill £27" for a £55 design).
  quotedPriceMinor Int?

  status String  @default("booked") // booked | cancelled | completed | no_show
  source String  @default("voice") // voice | manual | website
  notes  String?

  // SMS state. Columns rather than a message table: the only question staff
  // ask is "did the text go?", and a delivery-audit story can come later.
  confirmationSentAt DateTime?
  confirmationError  String?
  // Set the moment a reminder is attempted, not when it succeeds, so a cron
  // run that overlaps itself cannot text the same client twice.
  reminderSentAt     DateTime?
  reminderError      String?

  notices BookingNotice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Photos the client sent when booking by message.
  photos ChatPhoto[]

  @@unique([organizationId, bookingNumber])
  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([organizationId, technicianId, startsAt])
  @@map("ca_appointments")
}

// A booking the receptionist took, for one person at the salon: a pop-up on
// their screen until they close it or open the booking, and its own colour in
// the diary until they open it (src/lib/booking-notices.ts). One row per
// person, because each has their own screen and their own idea of "seen".
model BookingNotice {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  // The pop-up was closed, or the booking opened.
  dismissedAt    DateTime?
  // The booking was opened.
  seenAt         DateTime?

  @@unique([userId, appointmentId])
  @@index([userId, dismissedAt])
  @@map("ca_booking_notices")
}

// A phone or computer that asked for push notifications, as the browser's
// push service describes it. Removed when the service says it has gone.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("ca_push_subscriptions")
}

// ─────────────────────────────────────────────────────────────
// WhatsApp
// ─────────────────────────────────────────────────────────────

model WhatsAppConversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waId           String
  phoneNumber    String
  contactName    String?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  status         String       @default("active")
  isRead         Boolean      @default(false)
  starred        Boolean      @default(false)
  lastMessageAt  DateTime     @default(now())

  messages  WhatsAppMessage[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // When the org's system prompt changes, the admin can flip this to
  // NOW() so the AI ignores conversation history older than the reset
  // when generating its next reply. Customer-facing inbox UI still
  // shows the full history — only the prompt-construction path filters.
  // NULL = no reset, feed all history (default behaviour).
  personaResetAt DateTime?

  @@unique([organizationId, waId])
  @@index([organizationId])
  @@index([waId])
  @@index([phoneNumber])
  @@index([status])
  @@index([lastMessageAt])
  // Compound indexes covering the conversations-page query patterns:
  //   - default sort (orgId + lastMessageAt DESC)
  //   - unread filter (orgId + isRead, then range over lastMessageAt)
  //   - starred filter (orgId + starred + lastMessageAt DESC)
  // Without these, the unread/starred filters on a tenant with 10k+
  // conversations table-scan after picking the orgId index.
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, isRead, lastMessageAt(sort: Desc)])
  @@index([organizationId, starred, lastMessageAt(sort: Desc)])
  @@map("ca_whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  waMessageId    String?              @unique
  status         String               @default("sent")
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("ca_whatsapp_messages")
}

// ─────────────────────────────────────────────────────────────
// Website chatbot
// ─────────────────────────────────────────────────────────────

model WebsiteConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  name           String
  botName        String       @default("Assistant")
  systemPrompt   String
  greeting       String?
  quickReplies   Json         @default("[]")
  brandColor     String       @default("#2563eb")
  allowedOrigins Json         @default("[]")
  enabled        Boolean      @default(true)

  // Launcher presentation. Position and offset exist mainly to get out of the
  // way of whatever else already lives in a client's bottom-right corner —
  // cookie banners, back-to-top buttons, other vendors' widgets.
  launcherPosition String  @default("right") // "right" | "left"
  launcherOffset   Int     @default(20) // px from the bottom and side
  launcherLabel    String? // e.g. "Chat with us" — pill instead of a circle
  launcherIcon     String? // single emoji; null uses the default chat glyph

  // Panel theme. "auto" follows the visitor's OS setting.
  theme      String @default("light") // "light" | "dark" | "auto"
  fontFamily String @default("system") // see FONT_STACKS in the embed page

  // Which Claude model answers for this site. null means "best the plan
  // allows". Always re-clamped against the org's planTier at request time, so
  // a stored choice cannot outlive a downgrade.
  chatModel String?

  // White-label. Only honoured on plans permitted to remove attribution —
  // re-checked server-side per request, so a downgrade restores it without
  // anyone rewriting stored rows.
  hideBranding Boolean @default(false)

  // Proactive teaser: a small prompt that appears beside the collapsed
  // launcher after a delay, to open a conversation rather than waiting to be
  // found. Off by default — an unsolicited popup on a client's site is their
  // decision to make, not a default we impose.
  proactiveEnabled       Boolean @default(false)
  proactiveMessage       String?
  proactiveDelaySeconds  Int     @default(15)
  // Hours before the same visitor may be shown it again. 0 means once only.
  proactiveCooldownHours Int     @default(24)

  // Where the widget sends someone who wants a person.
  //
  // This replaced a "Talk to a person" button. That button promised a human on
  // a product whose whole premise is that nobody is watching the chats — a
  // visitor asking for someone got silence. Pointing them at the booking or
  // contact form the client already has is a promise the site can actually
  // keep.
  //
  // ctaSelector is a CSS selector on the *host* page (e.g. "#book-a-demo"):
  // widget.js scrolls to it and focuses the first field. ctaUrl is the
  // fallback for pages where that element doesn't exist. Both null means no
  // button — better to offer nothing than a control that goes nowhere.
  ctaLabel    String?
  ctaSelector String?
  ctaUrl      String?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  conversations WebsiteConversation[]

  @@unique([siteId])
  @@index([organizationId])
  @@map("ca_website_configs")
}

model WebsiteConversation {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId             String
  site               WebsiteConfig    @relation(fields: [siteId], references: [siteId])
  sessionId          String           @unique
  leadId             String?
  lead               Lead?            @relation(fields: [leadId], references: [id])
  visitorName        String?
  visitorEmail       String?
  visitorPhone       String?
  status             String           @default("active")
  isRead             Boolean          @default(false)
  starred            Boolean          @default(false)
  lastMessageAt      DateTime         @default(now())
  // Human handoff. "bot" is the normal state; "requested" means the visitor
  // asked for a person and the bot has stopped answering; "human" means an
  // operator has actually replied. The bot stays silent in both non-bot
  // states — answering over a waiting human is worse than a slow reply.
  handoffState       String           @default("bot")
  handoffRequestedAt DateTime?
  userAgent          String?
  referrer           String?
  messages           WebsiteMessage[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // See WhatsAppConversation for personaResetAt rationale.
  personaResetAt DateTime?

  @@index([organizationId])
  @@index([siteId])
  @@index([sessionId])
  @@index([lastMessageAt])
  // See WhatsAppConversation for index rationale.
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, isRead, lastMessageAt(sort: Desc)])
  @@index([organizationId, starred, lastMessageAt(sort: Desc)])
  @@map("ca_website_conversations")
}

model WebsiteMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   WebsiteConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@map("ca_website_messages")
}

// ─────────────────────────────────────────────────────────────
// Social messaging (Instagram DMs + Facebook Messenger)
//
// Unified pair for channels that ride Meta's Graph API but aren't
// WhatsApp. `channel` column distinguishes them ("instagram" | "facebook")
// and the table shape is extensible to future social channels (Twitter
// DMs, etc.) without further schema changes. WhatsApp keeps its own
// tables — those already work and migrating them is out of scope.
// ─────────────────────────────────────────────────────────────

model SocialConversation {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        String // "instagram" | "facebook"
  externalUserId String // IG scoped user id OR Messenger PSID
  contactName    String?
  // Cached profile data fetched from Graph API on first contact, used for
  // displaying the lead with a real handle and avatar instead of the
  // opaque externalUserId. `contactHandle` is IG @username; FB has no
  // native handle equivalent so it stays null for facebook conversations.
  contactHandle  String?
  profilePicUrl  String?
  leadId         String?
  lead           Lead?           @relation(fields: [leadId], references: [id])
  status         String          @default("active")
  isRead         Boolean         @default(false)
  starred        Boolean         @default(false)
  lastMessageAt  DateTime        @default(now())
  messages       SocialMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // See WhatsAppConversation for personaResetAt rationale.
  personaResetAt DateTime?

  @@unique([organizationId, channel, externalUserId])
  @@index([organizationId])
  @@index([channel])
  @@index([lastMessageAt])
  // See WhatsAppConversation for index rationale.
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, isRead, lastMessageAt(sort: Desc)])
  @@index([organizationId, starred, lastMessageAt(sort: Desc)])
  @@map("ca_social_conversations")
}

model SocialMessage {
  id                String             @id @default(cuid())
  conversationId    String
  conversation      SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String // "user" | "assistant"
  content           String
  externalMessageId String?            @unique
  status            String             @default("sent")
  createdAt         DateTime           @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("ca_social_messages")
}

/// Time a stylist (or the whole salon) cannot be booked: lunch, a holiday,
/// training, a bank holiday closure.
///
/// Two shapes. A one-off block is a pair of instants, which covers an hour, a
/// day or a fortnight's holiday alike. A weekly block is a rule — these
/// weekdays, this wall-clock window, between these dates — expanded per day in
/// the salon's timezone when read (src/lib/time-blocks.ts), so "1pm to 2pm"
/// stays 1pm to 2pm across the clock change. Storing each week as its own row
/// would drift at the change and need topping up forever.
model TimeBlock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null blocks everyone: the salon is shut.
  stylistName  String?
  /// The technician kept out, by id; null with stylistName for the whole salon.
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  label        String
  allDay       Boolean     @default(false)

  /// "none" | "weekly"
  repeat String @default("none")

  // One-off: the instants it runs between.
  startsAt DateTime?
  endsAt   DateTime?

  // Weekly: 0 = Sunday ... 6 = Saturday, "HH:MM" wall-clock times ("24:00"
  // for end of day), and the YYYY-MM-DD dates it runs from and until
  // (inclusive, until optional). skipDates are single weeks taken out.
  weekdays  Int[]    @default([])
  startTime String?
  endTime   String?
  fromDate  String?
  untilDate String?
  skipDates String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, technicianId])
  @@map("ca_time_blocks")
}

// What our own receptionist cost to run, one row per call (or per typed lab
// turn). Vapi calls are not here: Vapi reports its own cost, kept on Call.
//
// The cost is worked out from the usage when the row is written and stored in
// US dollars (the currency the providers bill in), in millionths, so a later
// price change never rewrites what an old call cost.
model UsageRecord {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // "lab_voice" and "lab_chat" today; "phone" once our receptionist answers
  // real calls. Lab usage is ours, not the salon's, and is never charged.
  source           String
  // Groups the turns of one typed lab conversation into one "call".
  sessionKey       String?
  startedAt        DateTime
  durationSeconds  Int          @default(0)
  model            String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  sttSeconds       Float        @default(0)
  ttsCharacters    Int          @default(0)
  telephonySeconds Int          @default(0)
  costMicros       Int
  createdAt        DateTime     @default(now())

  @@index([organizationId, startedAt])
  @@map("ca_usage_records")
}

/// One-off data changes the deploy has made (scripts/post-deploy.ts), so each
/// runs exactly once however many deploys follow.
model DataMigration {
  id    String   @id
  ranAt DateTime @default(now())

  @@map("ca_data_migrations")
}

/// A salon's nail technician, by a permanent id, and everything about her:
/// role, working days, services, calendar, place in the list, whether she
/// takes bookings, and her login. Bookings, blocked time, callbacks and rebook
/// texts point at her rather than at a name. OrganizationSettings.teamMembers
/// is a copy written in the same transaction, kept for one release so a
/// rollback still has the team. Renaming her changes `name` here and the name copied onto those
/// rows, in one transaction. Removing her archives the row: her history keeps
/// her name, and a technician added later with the same name is someone else
/// unless she is the one brought back (src/lib/technicians.ts).
model Technician {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  /// "Owner", "Senior nail technician": shown to staff and told to callers.
  role             String?
  email            String?
  phone            String?
  /// Her Google Calendar, on a salon whose diary is Google's.
  googleCalendarId String?
  /// 0 = Sunday ... 6 = Saturday. Empty: any day the salon is open.
  workingDays      Int[]         @default([])
  /// Service names she does. Empty: all of them.
  services         String[]      @default([])
  /// Her place in the team list, the diary's columns and the online picker.
  sortOrder        Int           @default(0)
  /// On the team but not booked into (a receptionist, an owner who no longer
  /// does nails): the diary, the phone and online booking leave her out.
  takesBookings    Boolean       @default(true)
  /// Her login, when she has one: what a per-person diary or permissions hang on.
  userId           String?       @unique
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set when she is taken off the team. Null while she is on it.
  archivedAt       DateTime?
  appointments     Appointment[]
  timeBlocks       TimeBlock[]
  callbacks        Callback[]
  rebookTexts      RebookText[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId])
  @@map("ca_technicians")
}

/// What Kikai charges, in pence a month, VAT included: "base" (the plan,
/// owner included), "seat" (each other team member) and each add-on
/// (src/lib/plan.ts). A missing base or seat row is the founder price; an
/// add-on with no row is not for sale yet. stripePriceId is the Stripe Price
/// made for this amount; a new amount makes a new Price, and salons already
/// subscribed keep the one they joined on.
model BillingPrice {
  key           String   @id
  pence         Int
  stripePriceId String?
  updatedAt     DateTime @updatedAt

  @@map("ca_billing_prices")
}

/// Every notice Stripe sends to /api/stripe/webhook, kept once by its id
/// (src/lib/stripe-events.ts): a notice sent again is skipped, one that
/// failed is retried when Stripe sends it again or Kikai replays it in
/// Admin, and Kikai has a record of what Stripe said and when.
model StripeEvent {
  /// Stripe's event id, "evt_...".
  id             String    @id
  type           String
  /// The salon it was for, once known.
  organizationId String?
  /// What it was about: the subscription, invoice or Checkout page id.
  objectId       String?
  /// "processing", "done" or "failed".
  status         String
  error          String?
  attempts       Int       @default(1)
  payload        Json
  receivedAt     DateTime  @default(now())
  /// When the latest try began: one "processing" long after is stuck.
  attemptedAt    DateTime  @default(now())
  processedAt    DateTime?

  @@index([organizationId, receivedAt])
  @@index([status, receivedAt])
  @@map("ca_stripe_events")
}

/// A copy of each Stripe invoice for a salon, kept up to date from Stripe's
/// notices and the nightly check (src/lib/stripe-invoices.ts): what was
/// billed, what was paid and when, and what is overdue, for Admin. Stripe's
/// own copy is the record; this one can always be made again from it.
model BillingInvoice {
  /// Stripe's invoice id, "in_...".
  id                 String       @id
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number             String?
  /// Stripe's: "draft", "open", "paid", "uncollectible" or "void".
  status             String
  currency           String
  /// In pence.
  total              Int
  amountDue          Int
  amountPaid         Int
  amountRemaining    Int
  periodStart        DateTime?
  periodEnd          DateTime?
  /// When Stripe made it.
  issuedAt           DateTime
  /// When it was due, for one sent to be paid by hand.
  dueAt              DateTime?
  paidAt             DateTime?
  /// Tries at taking payment so far, and when Stripe will try next.
  attemptCount       Int          @default(0)
  nextPaymentAttempt DateTime?
  hostedInvoiceUrl   String?
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, issuedAt])
  @@index([status])
  @@map("ca_billing_invoices")
}
